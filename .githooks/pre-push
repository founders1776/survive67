#!/bin/sh
# Publish a scrubbed public snapshot whenever main is pushed to origin
# (infra/publish-public.mjs). Never pushes private history. A failed publish
# does not block the private push, but it is loud and nothing goes public.
# Skip once with: C67_SKIP_PUBLISH=1 git push
remote="$1"
[ "$remote" = "origin" ] || exit 0
[ -n "$C67_SKIP_PUBLISH" ] && { echo "public snapshot: skipped (C67_SKIP_PUBLISH)"; exit 0; }
while read local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
  root="$(git rev-parse --show-toplevel)"
  if ! node "$root/infra/publish-public.mjs" "$local_sha"; then
    echo ""
    echo "!!! PUBLIC SNAPSHOT NOT PUBLISHED (see above). The private push continues."
    echo "!!! Fix the cause, then: node infra/publish-public.mjs"
  fi
done
exit 0
